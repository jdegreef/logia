","text":"רַ֝֗ב","after":" ","lemma":"רַב","morph":"Aamsa","gloss":"much","strong":"7227","transliteration":"raḇ","lang":"H","parse":"Adjective · masculine singular absolute"},{"id":"o191230030061","text":"שָׂבַ֥עְנוּ","after":" ","lemma":"שָׂבֵעַ","morph":"Vqp1cp","gloss":"we.have.been.surfeited","strong":"7646","transliteration":"śāḇaʿənû","lang":"H","parse":"Verb · Qal · perfect (qatal) · 1st person common plural"},{"id":"o191230030071","text":"בֽוּז","after":"׃","lemma":"בּוּז","morph":"Ncmsa","gloss":"contempt","strong":"0937","transliteration":"ḇûz:","lang":"H","parse":"Noun · common · masculine singular absolute"}],"4":[{"id":"o191230040011","text":"רַבַּת֮","after":" ","lemma":"רַב","morph":"Aafsc","gloss":"much","strong":"7227","transliteration":"rabbaṯ","lang":"H","parse":"Adjective · feminine singular construct (of ...)"},{"id":"o191230040021","text":"שָֽׂבְעָה","after":"־","lemma":"שָׂבֵעַ","morph":"Vqp3fs","gloss":"it.has.been.surfeited","strong":"7646","transliteration":"śāḇəʿâ-","lang":"H","parse":"Verb · Qal · perfect (qatal) · 3rd person feminine singular"},{"id":"o191230040031","text":"לָּ֪","after":"","lemma":"לְ","morph":"R","gloss":"(for","strong":"3807a","transliteration":"","lang":"H","parse":"Preposition"},{"id":"o191230040032","text":"הּ","after":" ","lemma":"הוּא","morph":"Sp3fs","gloss":"itself","strong":"1886d","transliteration":"","lang":"H","parse":"Suffix · pronoun · 3rd person feminine singular"},{"id":"o191230040041","text":"נַ֫פְשֵׁ֥","after":"","lemma":"נֶפֶשׁ","morph":"Ncbsc","gloss":"self","strong":"5315","transliteration":"","lang":"H","parse":"Noun · common · masculine or feminine singular construct (of ...)"},{"id":"o191230040042","text":"נוּ","after":" ","lemma":"הוּא","morph":"Sp1cp","gloss":"our","strong":"5105a","transliteration":"","lang":"H","parse":"Suffix · pronoun · 1st person common plural"},{"id":"o191230040051","text":"הַ","after":"","lemma":"הַ","morph":"Td","gloss":"the","strong":"1886a","transliteration":"ha","l