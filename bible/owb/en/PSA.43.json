ion"},{"id":"o190430010102","text":"עַוְלָ֣ה","after":" ","lemma":"עַוְלָה","morph":"Ncbsa","gloss":"injustice","strong":"5766a","transliteration":"ʿawlāh","lang":"H","parse":"Noun · common · masculine or feminine singular absolute"},{"id":"o190430010111","text":"תְפַלְּטֵֽ","after":"","lemma":"פָּלַט","morph":"Vpi2ms","gloss":"you","strong":"6403","transliteration":"","lang":"H","parse":"Verb · Piel · imperfect (yiqtol) · 2nd person masculine singular"},{"id":"o190430010112","text":"נִי","after":"׃","lemma":"הוּא","morph":"Sp1cs","gloss":"will.deliver.me","strong":"5204a","transliteration":"","lang":"H","parse":"Suffix · pronoun · 1st person common singular"}],"2":[{"id":"o190430020011","text":"כִּֽי","after":"־","lemma":"כִּי","morph":"C","gloss":"(dm)","strong":"3588","transliteration":"kiy-","lang":"H","parse":"Conjunction"},{"id":"o190430020021","text":"אַתָּ֤ה","after":"׀","lemma":"אַתָּה","morph":"Pp2ms","gloss":"you","strong":"0859","transliteration":"ʾattāh","lang":"H","parse":"Pronoun · personal · 2nd person masculine singular"},{"id":"o190430020031","text":"אֱלֹהֵ֣י","after":" ","lemma":"אֱלֹהִים","morph":"Ncmpc","gloss":"[are].the.God","strong":"0430","transliteration":"ʾĕlōhēy","lang":"H","parse":"Noun · common · masculine plural construct (of ...)"},{"id":"o190430020041","text":"מָֽעוּזִּ","after":"","lemma":"מָעוֹז","morph":"Ncmsc","gloss":"my.refuge","strong":"4581","transliteration":"","lang":"H","parse":"Noun · common · masculine singular construct (of ...)"},{"id":"o190430020042","text":"י֮","after":" ","lemma":"הוּא","morph":"Sp1cs","gloss":"my","strong":"2967a","transliteration":"","lang":"H","parse":"Suffix · pronoun · 1st person common singular"},{"id":"o190430020051","text":"לָ","after":"","lemma":"לָמָה","morph":"R","gloss":"","strong":"3807a","transliteration":"lā","lang":"H","parse":"Preposition"},{"id":"o190430020052","text":"מָ֪ה","after":" ","lemma":"מָה","morph":"Ti","gloss":"why?","strong":"4100","transliteration":"māh","lang":"H","pa